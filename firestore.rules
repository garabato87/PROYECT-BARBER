rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Users: each user can only access their own document.
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId 
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super-admin', 'professional']
      );

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == 'client';

      allow update: if request.auth != null
                    && (
                      // Usuario actualizando su propio perfil (sin cambiar rol ni local)
                      (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'barbershopId']))
                      // Super admin actualizando a cualquier usuario
                      || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super-admin'
                      // O un admin asignando/desasignando a un profesional a su propio local
                      || (
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
                        && request.resource.data.role in ['professional', 'client']
                        && request.resource.data.barbershopId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.barbershopId
                        && get(/databases/$(database)/documents/users/$(userId)).data.role in ['client', 'professional']
                      )
                    );

      allow delete: if false;
    }

    // Businesses: public listing.
    // Admin can create their own business. Admin and Super Admin can update. Only super admin can delete.
    match /businesses/{shopId} {
      allow read: if true;
      allow create: if request.auth != null
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
                    && (
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super-admin'
                      || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' && resource.data.ownerId == request.auth.uid)
                    );
      allow delete: if request.auth != null
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super-admin';
    }

    // Services: Subcollection inside businesses. Public read, write by business owner.
    match /businesses/{shopId}/services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null
                   && (
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super-admin'
                     || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.barbershopId == shopId)
                   );
    }

    // Professionals: Subcollection inside businesses. Public read, write by business owner.
    match /businesses/{shopId}/professionals/{professionalId} {
      allow read: if true;
      allow write: if request.auth != null
                   && (
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super-admin'
                     || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.barbershopId == shopId)
                   );
    }

    // Appointments: Subcollection inside businesses.
    match /businesses/{shopId}/appointments/{apptId} {
      // Allow all authenticated users to read appointments to compute availability on the client side.
      allow read: if request.auth != null;

      allow create: if request.auth != null && (
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super-admin'])
        || request.resource.data.get('clientId', '') == request.auth.uid
      );

      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super-admin'
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'professional'] && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.barbershopId == shopId)
      );
      
      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super-admin'
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.barbershopId == shopId)
      );
    }
    
    // Collection Group Queries for appointments
    // Allow clients to read their own appointments across all businesses.
    match /{path=**}/appointments/{apptId} {
      allow read: if request.auth != null && resource.data.get('clientId', '') == request.auth.uid;
      
      // Allow clients to cancel their own appointments
      allow update: if request.auth != null 
                    && resource.data.get('clientId', '') == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status == 'cancelled';
    }
  }
}
