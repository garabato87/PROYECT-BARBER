rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return request.auth != null
        && getUserData().get('disabled', false) != true
        && getUserData().get('status', '') != 'suspended';
    }

    function isSuperAdmin() {
      return activeUser() && getUserData().role == 'super-admin';
    }

    function shopAdmin(shopId) {
      return activeUser() && getUserData().role == 'admin'
        && getUserData().get('barbershopId', '') == shopId;
    }

    // Users: each user can only access their own document.
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId 
        || isSuperAdmin()
      );

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == 'client'
                    && request.resource.data.keys().hasOnly(['name', 'lastName', 'email', 'phone', 'dni', 'birthDate', 'photoURL', 'role']);

      allow update: if request.auth != null
                    && (
                      // Usuario actualizando su propio perfil (sin cambiar rol ni local)
                      (request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'lastName', 'email', 'phone', 'dni', 'birthDate', 'photoURL']))
                      // Super admin actualizando a cualquier usuario
                      || isSuperAdmin()
                    );

      allow delete: if false;
    }

    // Businesses: public listing.
    // Admin can create their own business. Admin and Super Admin can update. Only super admin can delete.
    match /businesses/{shopId} {
      allow read: if true;
      allow create: if request.auth != null
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
                    && (
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super-admin'
                      || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' && resource.data.ownerId == request.auth.uid)
                    );
      allow delete: if request.auth != null
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super-admin';
    }

    // Services: Subcollection inside businesses. Public read, write by business owner.
    match /businesses/{shopId}/services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null
                   && (
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super-admin'
                     || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.barbershopId == shopId)
                   );
    }

    // Professionals: Subcollection inside businesses. Public read, write by business owner or the professional.
    match /businesses/{shopId}/professionals/{professionalId} {
      allow read: if true;
      // Membership changes use the server command; clients can edit public fields only.
      allow create, delete: if false;
      allow update: if activeUser() && (
        ((isSuperAdmin() || shopAdmin(shopId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL', 'isActive', 'workingDays', 'specialty', 'schedule']))
        || (request.auth.uid == professionalId
          && getUserData().role in ['professional', 'admin']
          && getUserData().get('barbershopId', '') == shopId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL']))
      );
    }

    // Availability: Public projection of booked slots (No PII)
    match /businesses/{shopId}/availability/{apptId} {
      allow read: if true;
      allow write: if false; // Blocked: Only backend can write
    }

    // Appointments: Subcollection inside businesses. Contains PII (email, phone, name)
    match /businesses/{shopId}/appointments/{apptId} {
      allow read: if activeUser() && (
        isSuperAdmin()
        || shopAdmin(shopId)
        || (getUserData().role == 'professional'
          && getUserData().get('barbershopId', '') == shopId
          && resource.data.professionalId == request.auth.uid)
        || resource.data.get('clientId', '') == request.auth.uid
      );
      allow write: if false; // Blocked: Only backend can write
    }
    
    // Collection Group Queries for appointments
    // Allow clients to read their own appointments across all businesses.
    match /{path=**}/appointments/{apptId} {
      allow read: if activeUser() && resource.data.get('clientId', '') == request.auth.uid;
      allow write: if false;
    }
  }
}
