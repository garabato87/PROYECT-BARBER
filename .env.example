# Firebase configuration (Frontend)
# Copy this file to .env.local and fill in your Firebase project values.
# Never commit .env.local to version control.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Vercel / Backend Environment Variables
# These variables should be configured in Vercel or your local environment running Vercel CLI.
# Do NOT prefix with VITE_ as they are secrets used only in api/ endpoints.

# Firebase Admin SDK credential JSON (as a single line string)
FIREBASE_SERVICE_ACCOUNT=

# Resend Email Configuration
RESEND_API_KEY=
RESEND_FROM=

# Test mode email overrides (when not in 'live' mode)
NOTIFICATIONS_MODE=off
NOTIFICATIONS_TEST_RECIPIENT=

# Base URL for email links
APP_BASE_URL=https://www.vanitysoftware.net

# Cron security secret
CRON_SECRET=

# Required to verify the original signed body of Resend webhook requests.
RESEND_WEBHOOK_SECRET=
